{{ pklComment "" "This file was auto-generated by pklbenthos. Do not edit it by hand." }}
{{ with .Documentation }}
{{ pklDoc "" . }}
{{- end }}
{{ list .Modifiers.String "module" .Name | join " " | trim }}
{{- with .Extends }}
extends {{ . | quote }}
{{- end }}
{{- with .Amends }}
amends {{ . | quote }}
{{- end }}
{{- with .Imports }}
{{ range . }}
import {{ .Path | quote }}{{ with .Alias }} as {{ . }}{{ end }}
{{- end }}
{{- end }}
{{- range .TypeAliases }}

{{ with .Documentation }}{{ pklDoc "" . }}
{{ end }}typealias {{ .Name }} = {{ .Type }}
{{- end }}
{{- range .Properties }}

{{ with .Documentation }}{{ pklDoc "" . }}
{{ end }}{{ . }}
{{- end }}
{{- range .Classes }}

{{ with .Documentation }}{{ pklDoc "" . }}
{{ end }}{{ .Declaration }} {
{{- range $index, $property := .Properties }}
{{ if $index }}
{{ end }}{{ with $property.Documentation }}{{ pklDoc "  " . }}
{{ end }}  {{ $property }}
{{- end }}
}
{{- end }}
{{- with .Output }}

output {
{{- with .Value }}
  value = {{ . }}
{{- end }}
{{- with .Converters }}
  renderer {
    converters {
{{- range . }}
      [{{ .Key }}] = {{ .Function }}
{{- end }}
    }
  }
{{- end }}
}
{{- end }}
