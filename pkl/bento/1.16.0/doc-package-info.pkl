/// Pkl library for the configuration of Bento 1.16.0.
///
/// Every component of the build has a module of its own, and every field
/// of a component has a type. A pipeline amends `Configuration.pkl` and
/// renders as the YAML that Bento reads.
amends "pkl:DocPackageInfo"

name = "com.warpstream.bento"
version = "1.16.0"
importUri = "https://github.com/pauloborges/pklbenthos/releases/download/bento-1.16.0@1.0.0/bento-1.16.0@1.0.0#/"
authors { "Paulo Borges <coding@pauloborges.pw>" }
sourceCode = "https://github.com/pauloborges/pklbenthos"
issueTracker = "https://github.com/pauloborges/pklbenthos/issues"
