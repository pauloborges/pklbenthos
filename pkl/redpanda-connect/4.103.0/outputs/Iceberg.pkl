class SchemaEvolution {
  /// Enable automatic schema evolution. When enabled, new columns will be automatically
  /// added to the table.
  ///
  /// Default: `false`
  enabled: Boolean?

  /// A bloblang expression to evaluate when a new table is created to determine the
  /// table's partition spec. The result of the mapping should be an iceberg partition
