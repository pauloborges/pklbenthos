class IncrementalSnapshot {
  /// Backfills each table while streaming, in single- or multi-table mode (in multi-table
  /// mode, tables found by discovery are backfilled too). It never emits a snapshot item
  /// after a newer change to the same key. With `signal_table_name` set, a table is
  /// backfilled only when a `snapshot-execute` signal names it, apart from the exceptions
  /// listed under `signal_table_name`. It requires a stream view of `NEW_IMAGE` or
  /// `NEW_AND_OLD_IMAGES`, and reads with strongly consistent Scans (twice the RCU of the
  /// other modes). It backfills a table once, even if that table was previously only
  /// streamed. A `snapshot-execute` signal backfills a completed table again. Each page
  /// waits a few seconds for the stream to catch up, so for large tables raise
  /// `snapshot_segments` and `snapshot_batch_size` (for example to 10 and 1000). It also
  /// needs `dynamodb:DeleteItem` on the checkpoint table, because a stale-checkpoint
  /// reset and a repeat signal delete snapshot progress rows. It needs `snapshot_mode:
  /// none`: the other modes read the same items, and the input fails to start if both are
  /// set.
  ///
  /// Default: `false`
  enabled: Boolean?

  /// Extra time a snapshot page is held after every shard has streamed past the time of
  /// its Scan. The margin covers clock skew between this host and AWS, plus stream
  /// publication delay. For an idle shard, the input treats the start of its last empty
  /// poll, minus this margin, as the point the shard has streamed to. A page can
  /// therefore wait up to twice the margin before release. This only affects the order in
  /// which snapshot items leave the input relative to older stream events. It does not
  /// affect the correctness of the final value emitted for each key.
  ///
  /// Default: `"2s"`
  watermark_margin: String?

  /// How long a stream shard that has never returned a record must keep returning empty
  /// reads before it is treated as caught up. Until then it holds back every snapshot
  /// page of its table. It also bounds how long a listed shard that has no reader yet
  /// (for example one that is still failing to start) holds back pages. This only affects
  /// the order in which snapshot items leave the input relative to older stream events.
  /// It does not affect the correctness of the final value emitted for each key.
  ///
  /// Default: `"1m"`
  idle_shard_grace: String?
}

class Tcp {
  /// Maximum amount of time a dial will wait for a connect to complete. Zero disables.
  ///
  /// Default: `"0s"`
  connect_timeout: String?

  /// TCP keep-alive probe configuration.
  keep_alive: TcpKeepAlive?

  /// Maximum time to wait for acknowledgment of transmitted data before killing the
  /// connection. Linux-only (kernel 2.6.37+), ignored on other platforms. When enabled,
  /// keep_alive.idle must be greater than this value per RFC 5482. Zero disables.
  ///
  /// Default: `"0s"`
  tcp_user_timeout: String?
}

class TcpKeepAlive {
  /// Duration the connection must be idle before sending the first keep-alive probe. Zero
  /// defaults to 15s. Negative values disable keep-alive probes.
  ///
  /// Default: `"15s"`
  idle: String?

  /// Duration between keep-alive probes. Zero defaults to 15s.
  ///
  /// Default: `"15s"`
  interval: String?

  /// Maximum unanswered keep-alive probes before dropping the connection. Zero defaults
  /// to 9.
  ///
  /// Default: `9`
  count: Int?
}

class Credentials {
  /// The profile from `~/.aws/credentials` to use.
  profile: String?

  /// The ID of the AWS credentials to use.
  id: String?

  /// The secret for the AWS credentials in use.
  ///
  /// This field holds a secret.
  secret: String?

  /// The token for the AWS credentials in use. Required only when using short-term
  /// credentials.
  token: String?

  /// Use the credentials of a host EC2 machine configured to assume [an IAM role
  /// associated with the
  /// instance](https://docs.aws.amazon.com/IAM/latest/UserGuide/id_roles_use_switch-role-ec2.html).
  from_ec2_role: Boolean?

  /// The ARN of the role to assume.
  role: String?

  /// An external ID to use when assuming a role.
  role_external_id: String?
}
